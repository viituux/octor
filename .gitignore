# Credenciais e variáveis locais: os exemplos sem segredos continuam versionáveis.
.env
.env.*
!.env.*.example
!.env.example
# Banco e mídias locais não pertencem ao histórico Git.
*.sqlite3
*.sqlite3-*
back/media/
# Dependências, caches e artefatos gerados são recriados pelas ferramentas.
node_modules/
venv/
.venv/
__pycache__/
*.py[cod]
.angular/
dist/
coverage/
.idea/
.vscode/
*.log

# Backups locais podem conter dados pessoais e credenciais de contas.
back/backups/

# Evidências brutas de manuais são privadas e não entram no Git.
back/private_manuals/
back/private_trainings/

# Materiais de trabalho e suítes locais ficam fora da edição publicada.
/output/
/tmp/
/docs/entregas/
/back/staticfiles/
/front/tests/
/extensao/tests/
/back/**/test_*.py
/back/**/tests.py
