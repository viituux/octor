# Configure o provedor apenas no servidor; a aplicação web não deve receber a chave.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Modelo opcional: substitui o padrão do provedor configurado sem mudar o contrato da API.
LLM_MODEL=gemini-3.1-flash-lite

# Opcional: somente Manual por URL. Vazio mantém o provedor acima.
MANUAL_LLM_PROVIDER=openrouter
MANUAL_LLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Segredo exclusivo do backend; nunca colocar no Angular ou na extensão.
OPENROUTER_API_KEY=
