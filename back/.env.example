# Copie para back/.env e configure somente na máquina/servidor. Nunca versione credenciais reais.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, use DEBUG=False e gere dois segredos distintos de pelo menos 50 caracteres.
JWT_SIGNING_KEY=
# Se frontend, API ou extensão tiverem origens diferentes, configure as origens exatas.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Ative somente atrás de proxy que sobrescreva X-Forwarded-Proto de forma confiável.
TRUST_HTTPS_PROXY=False
# PostgreSQL obrigatório: crie o banco e preencha a conexão abaixo.
DB_NAME=octor_db
DB_USER=octor_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
LLM_PROVIDER=gemini
LLM_API_KEY=
GOOGLE_CLIENT_ID=


# Chave Fernet exclusiva do servidor para habilitar chaves de IA próprias.
OCTOR_AI_ENCRYPTION_KEY=
# Narração Gemini: sem chave dedicada, usa LLM_API_KEY se LLM_PROVIDER=gemini.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# SMTP para avisos dos relatos de suporte. Use credenciais do provedor escolhido.
SUPPORT_EMAIL=suporte@octor.app.br
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

PENDENCIA_TTL_HORAS=24
