SECRET_KEY=django-insecure-autoguide-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Banco de dados: Deixe DB_ENGINE vazio ou sqlite3 para desenvolvimento local rápido
# Quando iniciar o Docker Desktop (docker compose up -d), mude para DB_ENGINE=postgresql
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3

# Se usando postgres no docker:
# DB_ENGINE=postgresql
# DB_NAME=autoguide_db
# DB_USER=autoguide_user
# DB_PASSWORD=autoguide_password
# DB_HOST=localhost
# DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
