{
  "manifest_version": 3,
  "name": "OCTOR - Gravador de Procedimentos",
  "version": "1.2.5",
  "description": "Grava suas ações no navegador e gera tutoriais passo a passo com capturas de tela.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "sidePanel"
  ],
  "optional_permissions": ["downloads"],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {"16": "octor-icon-16.png", "32": "octor-icon-32.png", "48": "octor-icon-48.png", "128": "octor-icon-128.png"},
  "action": {
    "default_icon": {"16": "octor-icon-16.png", "32": "octor-icon-32.png", "48": "octor-icon-48.png", "128": "octor-icon-128.png"},
    "default_title": "Abrir OCTOR"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "environment.js",
        "theme.js",
        "targets.js",
        "content.js",
        "playback.js",
        "manual-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["octor-icon.png"], "matches": ["<all_urls>"] }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "minimum_chrome_version": "116",
  "externally_connectable": {
    "matches": [
      "https://octor.app.br/*"
    ]
  }
}
